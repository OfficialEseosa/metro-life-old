# API origin, without a trailing slash. Leave empty to use the same origin
# (the Vite dev server proxies /api and /ws to the backend).
# Production example: VITE_API_URL=https://metro-life-api.example.com
VITE_API_URL=

# Development only: where the Vite dev proxy forwards /api and /ws (default http://localhost:8080).
METRO_API_PROXY=
